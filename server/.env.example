# ── Server ──────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── MySQL ──────────────────────────────────────────────
# Must use async driver: mysql+aiomysql://user:pass@host:3306/dbname
MYSQL_CONNECTION_STRING=mysql+aiomysql://root:password@localhost:3306/website_downloader

# ── Storage ────────────────────────────────────────────
STORAGE_ROOT=./storage

# ── Session Limits ─────────────────────────────────────
MAX_SESSION_SIZE_MB=500
MAX_HTML_CHUNK_SIZE_PCT=25
DEFAULT_RETENTION_DAYS=7
MAX_RETENTION_DAYS=30
MIN_RETENTION_DAYS=1
STALE_SESSION_TIMEOUT_MINUTES=30

# ── CORS ───────────────────────────────────────────────
# JSON array of allowed origins. Use ["chrome-extension://*"] for extension-only access.
CORS_ALLOWED_ORIGINS=["chrome-extension://*"]

# ── Cleanup ────────────────────────────────────────────
CLEANUP_INTERVAL_HOURS=1
ORPHANED_API_KEY_AGE_DAYS=30

# ── API ────────────────────────────────────────────────
API_VERSION=v1

# ── Archive Service (gRPC mTLS) ────────────────────────
# Set these to connect to archive-service in production (mTLS mode).
# In Docker these are overridden by docker-compose.yml.
# ARCHIVE_SERVICE_ADDR=archive-service:50052
# ARCHIVE_CA_CERT=/app/certs/ca.pem
# ARCHIVE_CLIENT_KEY=/app/certs/extension-server-key.pem
# ARCHIVE_CLIENT_CERT=/app/certs/extension-server.pem
