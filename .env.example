# Server URL for PagePocket cloud service
# Used for server-side HTML merging and ZIP assembly.
#
# Examples:
#   VITE_SERVER_URL=http://localhost:8000
#   VITE_SERVER_URL=https://server.pagepocket.app
VITE_SERVER_URL=https://server.pagepocket.app

# Google sign-in OAuth client ID (easier-auth D7)
# Web-application client from Google Cloud Console (task 4.1 of
# openspec/changes/easier-auth); authorized redirect URI must be
# https://<extension-id>.chromiumapp.org/ (see scripts/prod/README.md §15).
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
