# Server mode configuration (optional)
# When set, the extension uploads resources to a Python microservice
# for server-side HTML merging and ZIP assembly.
# Leave empty or remove to use local-only mode (IndexedDB/JSZip).
#
# Examples:
#   VITE_SERVER_URL=http://localhost:8000
#   VITE_SERVER_URL=https://download-server.example.com
VITE_SERVER_URL=
