# PagePocket SaaS Backend Configuration

# MySQL
MYSQL_ROOT_PASSWORD=change-me-in-prod

# JWT
JWT_SECRET=change-me-to-a-strong-random-string

# Cloudflare R2 (archive-service only)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pagepocket-pages

# Share service
BASE_URL=https://your-domain.com

# mTLS (set MTLS_ENABLED=true in prod)
MTLS_ENABLED=false
