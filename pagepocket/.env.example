# PagePocket backend — environment template.
# Copy to .env and adjust:  cp .env.example .env
# Dev defaults below mirror docker-compose.yml so a fresh clone boots as-is.

# --- development defaults (safe to keep) ------------------------------------

# MySQL root password (DEV DEFAULT: pagepocket — never survive into prod)
MYSQL_ROOT_PASSWORD=pagepocket

# JWT signing key (dev default; the gateway refuses this value in production)
JWT_SECRET=dev-secret-change-me

# Redis password (dev default; REQUIRED to be a real secret in prod —
# see scripts/prod/roll-redis-password.sh)
REDIS_PASSWORD=dev-redis-change-me

# Per-service least-privilege MySQL users (D12/2.16). Dev defaults seed
# pagepocket_<svc> users via init-users.sh, but services still connect as
# root until you set DB_USER_<SVC> too. In prod run
# scripts/prod/rotate-db-users.sh — it generates and installs these.
DB_PASSWORD_AUTH=pp-auth-dev
DB_PASSWORD_ARCHIVE=pp-archive-dev
DB_PASSWORD_LIBRARY=pp-library-dev
DB_PASSWORD_SEARCH=pp-search-dev
DB_PASSWORD_SHARE=pp-share-dev
# DB_USER_AUTH=pagepocket_auth
# DB_USER_ARCHIVE=pagepocket_archive
# DB_USER_LIBRARY=pagepocket_library
# DB_USER_SEARCH=pagepocket_search
# DB_USER_SHARE=pagepocket_share

# --- needed when archiving for real -----------------------------------------

# Cloudflare R2 (archive-service only)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pagepocket-pages

# --- production-only (uncomment + set real values; the prod overlay,
# --- docker-compose.prod.yml, refuses to render without them) ---------------

# Public share-link base (share-service fails fast in prod without it)
#BASE_URL=https://pagepocket.app

# CORS origin allow-list (default: https://pagepocket.app,https://app.pagepocket.app)
#CORS_ALLOW_ORIGINS=https://pagepocket.app,https://app.pagepocket.app

# Proxies trusted for X-Forwarded-For (rate-limit identity). NARROW default
# in compose: the docker bridge gateways only (172.18.0.1,172.17.0.1).
# Verify on the host before overriding — see scripts/prod/README.md.
#TRUSTED_PROXIES=172.18.0.1,172.17.0.1

# 512-bit+ random secret (rotate off any committed default)
#MYSQL_ROOT_PASSWORD=<generated by scripts/prod/rotate-credentials.sh>
#REDIS_PASSWORD=<generated by scripts/prod/roll-redis-password.sh>

# --- tuning (optional, sane defaults baked into docker-compose.yml) ---------

# api-gateway uvicorn workers (default 2; limiter is Redis-backed, safe to raise)
#GATEWAY_WORKERS=2

# Max assets accepted per ingest request (default 200)
#MAX_INGEST_ASSETS=200

# Max accepted ingest request size in bytes (default 256 MB)
#MAX_UPLOAD_BYTES=268435456

# --- managed by the prod overlay (do NOT set for local dev) ----------------
# ENVIRONMENT=production      # set by docker-compose.prod.yml
# AUTO_CREATE=false           # set by docker-compose.prod.yml
# MTLS_ENABLED=true           # set by docker-compose.prod.yml
