    },
    "single_file_download_intro": {
        "message": "আপনি বর্তমান ওয়েব পেজটি একটি একক MHTML ফাইল (.mhtml) হিসাবে ডাউনলোড করতে চলেছেন।",
        "description": "একক ফাইল MHTML ডাউনলোডের জন্য ভূমিকা।"
    },
    "single_file_format_mhtml_title": {
        "message": "MHTML ফরম্যাট",
        "description": "MHTML ফরম্যাট ব্যাখ্যার জন্য শিরোনাম।"
    },
    "single_file_format_mhtml_desc": {
        "message": "MHTML (MIME HTML) একটি একক ফাইলে সমস্ত পেজ কন্টেন্ট (HTML, CSS, জাভাস্ক্রিপ্ট, ছবি) সংরক্ষণ করে।",
        "description": "MHTML ফরম্যাটের বর্ণনা।"
    },
    "single_file_includes_all_title": {
        "message": "সব অন্তর্ভুক্ত",
        "description": "'সমস্ত রিসোর্স অন্তর্ভুক্ত' করার জন্য শিরোনাম।"
    },
    "single_file_includes_all_desc": {
        "message": "নিশ্চিত করে যে সমস্ত রিসোর্স অন্তর্ভুক্ত করা হয়েছে, যা পেজটিকে সম্পূর্ণরূপে অফলাইনে কার্যকরী করে তোলে।",
        "description": "'সমস্ত রিসোর্স অন্তর্ভুক্ত' করার জন্য বর্ণনা।"
    },
    "single_file_offline_viewing_title": {
        "message": "অফলাইন দেখা",
        "description": "অফলাইন দেখার সুবিধার জন্য শিরোনাম।"
    },
    "single_file_offline_viewing_desc": {
        "message": "আর্কাইভিং পেজগুলির জন্য বা ইন্টারনেট সংযোগ ছাড়াই পরে সেগুলি দেখার জন্য আদর্শ।",
        "description": "অফলাইন দেখার সুবিধার জন্য বর্ণনা।"
    },
    "single_file_browser_support_title": {
