    },
    "single_file_format_mhtml_desc": {
        "message": "MHTML (MIME HTML) एक ही फ़ाइल में सभी पृष्ठ सामग्री (HTML, CSS, JavaScript, चित्र) को सहेजता है।",
        "description": "MHTML प्रारूप का विवरण।"
    },
    "single_file_includes_all_title": {
