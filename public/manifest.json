{
  "manifest_version": 3,
  "name": "Web Page Downloader",
  "description": "Web Page Downloader allows you to download and save entire web pages, including linked resources, for offline viewing.",
  "version": "2.6.3",
  "key": "",
  "action": {
    "default_icon": "icons/128x128.png",
    "default_title": "Web Page Downloader"
  },
  "permissions": ["activeTab", "tabs", "scripting", "sidePanel", "downloads"],
  "optional_permissions": ["storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "64": "icons/64x64.png",
    "96": "icons/96x96.png",
    "128": "icons/128x128.png",
    "256": "icons/256x256.png"
  }
}
