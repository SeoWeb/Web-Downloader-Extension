{
  "manifest_version": 3,
  "name": "__MSG_title__",
  "description": "__MSG_description__",
  "version": "3.0",
  "action": {
    "default_icon": "./icons/128x128.png",
    "default_title": "__MSG_title__",
    "default_popup": "popup.html"
  },
  "default_locale": "en",
  "permissions": ["sidePanel"],
  "optional_permissions": ["activeTab", "storage", "scripting", "downloads", "pageCapture"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "icons": {
    "16": "./icons/16x16.png",
    "32": "./icons/32x32.png",
    "48": "./icons/48x48.png",
    "64": "./icons/64x64.png",
    "96": "./icons/96x96.png",
    "128": "./icons/128x128.png",
    "256": "./icons/256x256.png"
  }
}
